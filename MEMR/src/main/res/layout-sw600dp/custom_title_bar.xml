	<RelativeLayout
		android:id="@+id/top_bg_buttons"
		android:layout_width="fill_parent"
		android:layout_height="fill_parent"
		android:layout_marginTop="@dimen/camera_area_height"
		android:orientation="horizontal"
		>
		<!-- 타이틀바의 높이는 style에 정의되어 있음. -->
		<!-- minWidth가 동작하지 않는다. -->
		<!-- RelativeLayout이기 때문일까??? -->
		<Button
			android:id="@+id/backButtonCTB"
			android:text=""
			android:textSize="@dimen/small_small_text_size"
			android:clickable="true"
			android:layout_width="wrap_content"
			android:layout_height="fill_parent"
			android:layout_marginLeft="9dip"
			android:layout_marginTop="@dimen/ctb_button_margin_top"
			android:layout_marginBottom="@dimen/ctb_button_margin_bottom"
			android:paddingLeft="@dimen/ctb_button_padding_left"
			android:paddingRight="@dimen/ctb_button_padding_right"
			android:minWidth="@dimen/button_min_width"
			android:background="@drawable/selector_button_background"
			android:drawableLeft="@drawable/prev_button_icon"
			android:drawablePadding="@dimen/button_drawable_padding"
			android:layout_alignParentLeft="true" />
		<TextView
			android:id="@+id/titleCTB"
			android:layout_width="wrap_content"
			android:layout_height="fill_parent"
			android:layout_marginTop="@dimen/ctb_title_margin_top"
			android:text=""
			android:textSize="@dimen/normal_text_size"
			android:textColor="@color/titleforeground"
			android:gravity="center"
			android:padding="8dip"
			android:layout_toRightOf="@+id/backButtonCTB" />

		<Button
			android:id="@+id/queryButtonCTB"
			android:text="@string/query"
