<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory xmlns:android="http://schemas.android.com/apk/res/android"
        android:title="정보">
        <Preference
            android:key="current_version"
            android:title="버전"
            />
    </PreferenceCategory>
    <PreferenceCategory xmlns:android="http://schemas.android.com/apk/res/android"
        android:title="사용자정보">
        <Preference
            android:key="hos_name"
            android:title="병원명칭"
            />
        <Preference
            android:key="user_name"
            android:title="사용자이름"
            />
    </PreferenceCategory>
    <PreferenceCategory xmlns:android="http://schemas.android.com/apk/res/android"
        android:title="기타">
        <Preference
            android:key="privacy"
            android:title="개인정보처리방침"
            />
        <Preference
            android:key="install"
            android:title="재설치"
            />
    </PreferenceCategory>
</PreferenceScreen>
