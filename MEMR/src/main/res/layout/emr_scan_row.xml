<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:orientation="horizontal"
	android:background="@drawable/shape_listview_row"
	>
	<!-- 오른쪽에 수정 버튼 -->
	<TextView
		android:id="@+id/btn_modify"
		android:layout_width="64dp"
		android:layout_height="54dp"
		android:layout_alignParentEnd="true"
		android:layout_alignParentRight="true"
		android:layout_centerVertical="true"
		android:gravity="center"
		android:text="수정"
		android:textSize="16sp"
		android:textColor="@color/titlebackground"
		android:background="@drawable/btn_modify_outline"
		android:padding="4dp"
		android:layout_marginRight="8dp"
		android:clickable="true"
		android:focusable="false" />
	<LinearLayout
		android:id="@+id/content_area"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_toStartOf="@id/btn_modify"
		android:layout_toLeftOf="@id/btn_modify"
		android:orientation="horizontal">
		<ImageView
			android:id="@+id/image"
			android:background="@drawable/image_border"
			android:layout_width="64dip"
			android:layout_height="64dip"
			android:gravity="center"
			android:paddingLeft="5dip"
			android:padding="10dip"
			android:visibility="gone"
			/>
		<TextView
			android:id="@+id/rptnm"
			android:textAppearance="?android:attr/textAppearanceLarge"
			android:textColor="@color/foreground"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:layout_gravity="center_vertical"
			android:paddingLeft="15dip"
			android:minHeight="70dip"
			/>
	</LinearLayout>
</RelativeLayout>