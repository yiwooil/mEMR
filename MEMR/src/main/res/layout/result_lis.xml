<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    >
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/patientInfoTextView"
            style="@style/PatientInfo"
            />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        >
	    <Button 
	       android:id="@+id/pickFrDate"
	        android:layout_width="wrap_content"
	        android:layout_height="wrap_content"
	        android:text=""/>
        <TextView 
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - "/>
        <Button 
            android:id="@+id/pickToDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
	    <TextView
	        android:text="처방일"
	        android:layout_width="70dip"
	        android:layout_height="wrap_content" />
        <TextView
            android:text="검사항목"
            android:layout_width="130dip"
            android:layout_height="wrap_content" />
        <TextView
            android:text="결과"
            android:layout_width="80dip"
            android:layout_height="wrap_content" />
        <TextView
            android:text="이전결과"
            android:layout_width="80dip"
            android:layout_height="wrap_content" />
        <TextView
            android:text="R"
            android:layout_width="8dip"
            android:layout_height="wrap_content" />
        <TextView
            android:text="P"
            android:layout_width="8dip"
            android:layout_height="wrap_content" />
        <TextView
            android:text="D"
            android:layout_width="8dip"
            android:layout_height="wrap_content" />
        <TextView
            android:text="참고치"
            android:layout_width="130dip"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:text=""
            android:layout_width="70dip"
            android:layout_height="wrap_content" />
        <TextView
            android:text="검체"
            android:layout_width="50dip"
            android:layout_height="wrap_content" />
        <TextView
            android:text="주치의"
            android:layout_width="50dip"
            android:layout_height="wrap_content" />
        <TextView
            android:text=""
            android:layout_width="30dip"
            android:layout_height="wrap_content" />
        <TextView
            android:text="결과단위"
            android:layout_width="60dip"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <ListView
        android:id="@+id/result_lis_list"  
        android:layout_width="fill_parent" 
        android:layout_height="fill_parent"
        />
</LinearLayout>
