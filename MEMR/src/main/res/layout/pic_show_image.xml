<?xml version="1.0" encoding="utf-8"?>

<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" 
    android:layout_height="match_parent" 
    android:orientation="vertical" 
    android:background="@color/temr_titlebackground"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="5dip"
        android:layout_marginTop="5dip"
        android:layout_marginRight="5dip"
        android:layout_marginBottom="5dip"
        android:background="@color/temr_titlebackground"
        >
<!--         <LinearLayout -->
<!--             android:layout_width="match_parent" -->
<!--             android:layout_height="wrap_content" -->
<!--             android:orientation="horizontal" -->
<!--             > -->
<!--         </LinearLayout> -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <Button
                android:id="@+id/back_button"    
                android:layout_width="80dip"
                android:layout_height="40dip"
                android:background="@drawable/selector_button_background"
                android:layout_alignParentLeft="true"
                android:text="닫기" />
            <Button
                android:id="@+id/rotate_button_0"    
                android:layout_width="90dip"
                android:layout_height="40dip"
                android:background="@drawable/selector_button_background"
                android:layout_toLeftOf="@+id/rotate_button_1"
                android:text="원래대로" />
            <Button
                android:id="@+id/rotate_button_1"    
                android:layout_width="90dip"
                android:layout_height="40dip"
                android:background="@drawable/selector_button_background"
                android:layout_toLeftOf="@+id/rotate_button_2"
                android:text="회전 90" />
            <Button
                android:id="@+id/rotate_button_2"    
                android:layout_width="90dip"
                android:layout_height="40dip"
                android:background="@drawable/selector_button_background"
                android:layout_toLeftOf="@+id/rotate_button_3" 
                android:text="회전 180" />
            <Button
                android:id="@+id/rotate_button_3"    
                android:layout_width="90dip"
                android:layout_height="40dip"
                android:background="@drawable/selector_button_background"
                android:layout_alignParentRight="true" 
                android:text="회전 270" />
        </RelativeLayout>
    </LinearLayout>
    
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minWidth="600dip"
            android:minHeight="600dip"
            android:background="@color/tab_unselected_color"
            android:paddingTop="2dip"
            android:paddingRight="4dip"
            android:paddingBottom="0dip"
            android:paddingLeft="4dip"
            >
	    <WebView 
	        android:id="@+id/pic_show_web"
	        android:layout_width="match_parent"
	        android:layout_height="match_parent"
	        >
	    </WebView>
    </LinearLayout>

</LinearLayout>