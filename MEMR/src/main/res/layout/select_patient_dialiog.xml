<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="5dip"
        android:layout_marginTop="5dip"
        android:layout_marginRight="5dip"
        android:layout_marginBottom="5dip"
        android:background="@color/temr_titlebackground"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
            <Button
                android:id="@+id/back_button"    
                android:layout_width="80dip"
                android:layout_height="40dip"
                android:background="@drawable/selector_button_background"
                android:layout_alignParentLeft="true"
                android:text="닫기" />
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout 
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dip"
        >
        <!-- 환자검색 탭 -->
        <RelativeLayout 
            android:id="@+id/tab_patient_search"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dip"
            >
            <!-- 환자명등 검색자료 -->
            <EditText
                android:id="@+id/search_text" 
                android:inputType="text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="2dip"
                android:layout_alignParentLeft="true"
                android:layout_toLeftOf="@+id/search_button"
                />
            <!-- 검색버튼 -->
            <Button
                android:id="@+id/search_button"
                android:text="검색"
                android:textSize="@dimen/small_small_text_size"
                android:drawableLeft="@drawable/search_button_icon"
                android:paddingLeft="10dip" 
                android:layout_width="80dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="2dip"
                android:layout_marginRight="2dip"
                android:layout_marginBottom="6dip"
                android:background="@drawable/selector_button_background"
                android:layout_alignParentRight="true"
                />
        </RelativeLayout>
        <!-- 자료가 조회되는 리스트가 보이는 부분 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minWidth="700dip"
            android:minHeight="400dip"
            android:background="@color/tab_unselected_color"
            android:paddingTop="2dip"
            android:paddingRight="4dip"
            android:paddingBottom="4dip"
            android:paddingLeft="4dip"
            >
            <ListView
                android:id="@+id/patient_list"  
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:cacheColorHint="@color/background"
                android:divider="@null"
                android:dividerHeight="0dip"
                />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>