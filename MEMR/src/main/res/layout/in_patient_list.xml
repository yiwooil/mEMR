<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/background"
    >
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dip"
        >
        <TabHost
            android:id="@+id/tabHost"
            android:layout_width="fill_parent" 
            android:layout_height="fill_parent" > 
	        <HorizontalScrollView
	            android:id="@+id/horizontalScrollView"
	            android:layout_width="fill_parent"
	            android:layout_height="wrap_content"
	            android:scrollbars="horizontal"
	            android:scrollbarAlwaysDrawHorizontalTrack="true" 
	            android:addStatesFromChildren="true"
	            android:fillViewport="true"
	            >
            <!-- 이곳이군 -->
            <TabWidget
                android:id="@android:id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/tab_unselected_color" />
            </HorizontalScrollView>
            <FrameLayout
                android:id="@android:id/tabcontent" 
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingTop="51dip" >
                <!-- 재원환자 탭 -->
                <LinearLayout 
                    android:id="@+id/tab_in_patient"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/option_bar_height"
		            android:background="@color/tab_unselected_color"
		            android:paddingTop="4dip"
		            android:paddingRight="4dip"
		            android:paddingBottom="0dip"
		            android:paddingLeft="4dip"
                    >
                    <!-- 병동 선택 버튼 -->
                    <Button
                        android:id="@+id/ward_button"
                        android:textSize="@dimen/normal_text_size"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:background="@drawable/selector_button_background"
                        android:layout_weight="1" />
                    <!-- 진료과 선택 버튼 -->
                    <Button
                        android:id="@+id/dept_button"
                        android:textSize="@dimen/normal_text_size"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:background="@drawable/selector_button_background"
                        android:layout_weight="1" />
                    <!-- 의사 선택 버튼 -->
                    <Button
                        android:id="@+id/pdrid_button"
                        android:textSize="@dimen/normal_text_size"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:background="@drawable/selector_button_background"
                        android:layout_weight="1" />
                    <!-- 정렬순서 선택 버튼 -->
                    <Button
                        android:id="@+id/sort_order_button"
                        android:textSize="@dimen/normal_text_size"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:background="@drawable/selector_button_background"
                        android:layout_weight="1" />
                </LinearLayout>
                <!-- 외래환자 탭 -->
                <LinearLayout 
                    android:id="@+id/tab_out_patient"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/option_bar_height"
                    android:background="@color/tab_unselected_color"
                    android:paddingTop="4dip"
                    android:paddingRight="4dip"
                    android:paddingBottom="0dip"
                    android:paddingLeft="4dip"
                    >
                    <!-- 일자 선택 버튼 -->
                    <Button
                        android:id="@+id/out_exdt_button"
                        android:textSize="@dimen/normal_text_size"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:background="@drawable/selector_button_background"
                        android:layout_weight="1" />
                    <!-- 진료과 선택 버튼 -->
                    <Button
                        android:id="@+id/out_dept_button"
                        android:textSize="@dimen/normal_text_size"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:background="@drawable/selector_button_background"
                        android:layout_weight="1" />
                    <!-- 의사 선택 버튼 -->
                    <Button
                        android:id="@+id/out_pdrid_button"
                        android:textSize="@dimen/normal_text_size"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:background="@drawable/selector_button_background"
                        android:layout_weight="1" />
                    <!-- 정렬순서 선택 버튼 -->
                    <Button
                        android:id="@+id/out_sort_order_button"
                        android:textSize="@dimen/normal_text_size"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:background="@drawable/selector_button_background"
                        android:layout_weight="1" />
                    <!-- 입원예정자만 체크박스 -->
                    <CheckBox
                        android:id="@+id/out_reserved_inpatient_only"
                        android:text="입원예정자만"
                        android:textSize="@dimen/normal_text_size"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:background="@drawable/selector_button_background"
                        android:textColor="@android:color/black"
                        android:layout_weight="1"/>
                </LinearLayout>
                <!-- 환자검색 탭 -->
                <RelativeLayout 
                    android:id="@+id/tab_patient_search"
                    android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="40dip"
                    >
                    <LinearLayout
                        android:id="@+id/search_exdt_buttons"
                        android:orientation="horizontal"
                        android:paddingLeft="5dip"
                        android:paddingRight="5dip"
                        android:layout_width="405dip"
                        android:layout_height="fill_parent"
                        android:layout_alignParentLeft="true"
                        >
                        <!-- 2025.08.07 WOOIL - 입원.외래 검색 조건 추가 -->
                        <Button
                            android:id="@+id/search_iofg_button"
                            android:text=""
                            android:textSize="@dimen/normal_text_size"
                            android:paddingLeft="5dip"
                            android:paddingRight="5dip"
                            android:layout_width="70dip"
                            android:layout_height="fill_parent"
                            android:layout_marginTop="2dip"
                            android:layout_marginBottom="6dip"
                            android:background="@drawable/selector_button_background"
                            />
                        <!-- 2021.09.30 WOOIL - 검색용 일자 선택 버튼 -->
                        <Button
                            android:id="@+id/search_exdt_button"
                            android:text=""
                            android:textSize="@dimen/normal_text_size"
                            android:paddingLeft="5dip"
                            android:paddingRight="5dip"
                            android:layout_width="120dip"
                            android:layout_height="fill_parent"
                            android:layout_marginTop="2dip"
                            android:layout_marginBottom="6dip"
                            android:background="@drawable/selector_button_background"
                            />
                        <!-- 2023.03.27 WOOIL - 검색을 일자 범위로 하도록 종료일 추가 -->
                        <Button
                            android:id="@+id/search_exdt_to_button"
                            android:text=""
                            android:textSize="@dimen/normal_text_size"
                            android:paddingLeft="5dip"
                            android:paddingRight="5dip"
                            android:layout_width="120dip"
                            android:layout_height="fill_parent"
                            android:layout_marginTop="2dip"
                            android:layout_marginBottom="6dip"
                            android:background="@drawable/selector_button_background"
                            />
                        <!-- 2025.08.07 WOOIL - 화면 지움 -->
                        <Button
                            android:id="@+id/clear_button"
                            android:text="지움"
                            android:textSize="@dimen/normal_text_size"
                            android:paddingLeft="5dip"
                            android:paddingRight="5dip"
                            android:layout_width="80dip"
                            android:layout_height="fill_parent"
                            android:layout_marginTop="2dip"
                            android:layout_marginBottom="6dip"
                            android:background="@drawable/selector_button_background"
                            />
                    </LinearLayout>
                    <!-- 환자명등 검색자료 -->
                    <EditText
                        android:id="@+id/search_text" 
                        android:inputType="text"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_marginTop="2dip"
                        android:layout_toRightOf="@+id/search_exdt_buttons"
                        android:layout_toLeftOf="@+id/search_button"
                        />
                    <!-- 검색버튼 -->
                    <Button
                        android:id="@+id/search_button"
                        android:text="검색"
                        android:textSize="@dimen/small_small_text_size"
                        android:drawableLeft="@drawable/search_button_icon"
                        android:paddingLeft="5dip"
                        android:paddingRight="5dip"
                        android:layout_width="80dip"
                        android:layout_height="fill_parent"
                        android:layout_marginTop="2dip"
                        android:layout_marginRight="2dip"
                        android:layout_marginBottom="6dip"
                        android:layout_marginEnd="2dip"
                        android:background="@drawable/selector_button_background"
                        android:layout_alignParentRight="true"
                        />
                </RelativeLayout>
            </FrameLayout>
        </TabHost>
        <!-- 자료가 조회되는 리스트가 보이는 부분 -->
        <LinearLayout
            android:id="@+id/patient_list_layout"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="@color/tab_unselected_color"
            android:paddingTop="2dip"
            android:paddingRight="4dip"
            android:paddingBottom="4dip"
            android:paddingLeft="4dip"
            android:layout_marginBottom="@dimen/bottom_area_height"
            >

            <ListView
                android:id="@+id/patient_list"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:cacheColorHint="@color/background"
                android:divider="@null"
                android:dividerHeight="0dip" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>