<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="4dip"
    android:paddingBottom="6dip"
    android:layout_width="fill_parent"
    android:layout_height="40dip"
    android:orientation="horizontal"
    android:background="@drawable/shape_listview_row"
    >
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <TextView
            android:text="처방일"
            android:textColor="@color/foreground"
            android:textSize="@dimen/normal_text_size"
            android:layout_width="@dimen/result_lis_row_spcno_orddate_width"
            android:layout_height="wrap_content" />
        <TextView
            android:text="진료과"
            android:textColor="@color/foreground"
            android:textSize="@dimen/normal_text_size"
            android:layout_width="@dimen/result_lis_row_spcno_deptcd_width"
            android:layout_height="wrap_content" />
        <TextView
            android:text="병실"
            android:textColor="@color/foreground"
            android:textSize="@dimen/normal_text_size"
            android:layout_width="@dimen/result_lis_row_spcno_ward_width"
            android:layout_height="wrap_content" />
        <TextView
            android:text="처방의"
            android:textColor="@color/foreground"
            android:textSize="@dimen/normal_text_size"
            android:layout_width="@dimen/result_lis_row_spcno_ordnm_width"
            android:layout_height="wrap_content" />
        <TextView
            android:text="검사항목"
            android:textColor="@color/foreground"
            android:textSize="@dimen/normal_text_size"
            android:layout_width="@dimen/result_lis_row_spcno_alltestnm_width"
            android:layout_height="wrap_content" />
        <TextView
            android:text="검체"
            android:textColor="@color/foreground"
            android:textSize="@dimen/normal_text_size"
            android:layout_width="@dimen/result_lis_row_spcno_spcnm_width"
            android:layout_height="wrap_content" />
        <TextView
            android:text="상태"
            android:textColor="@color/foreground"
            android:textSize="@dimen/normal_text_size"
            android:layout_width="@dimen/result_lis_row_spcno_stsnm_width"
            android:layout_height="wrap_content" />
        <TextView
            android:text="검사일시"
            android:textColor="@color/foreground"
            android:textSize="@dimen/normal_text_size"
            android:layout_width="@dimen/result_lis_row_spcno_vfydtm_width"
            android:layout_height="wrap_content" />
        <TextView
            android:text="접수일시"
            android:textColor="@color/foreground"
            android:textSize="@dimen/normal_text_size"
            android:layout_width="@dimen/result_lis_row_spcno_rcvdtm_width"
            android:layout_height="wrap_content" />
        <TextView
            android:text="검체번호"
            android:textColor="@color/foreground"
            android:textSize="@dimen/normal_text_size"
            android:layout_width="@dimen/result_lis_row_spcno_spcno_width"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>