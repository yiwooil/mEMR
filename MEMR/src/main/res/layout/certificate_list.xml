<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/patient_list_layout"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    >
    <!-- 구분선 -->
    <LinearLayout 
        android:layout_width="fill_parent"
        android:layout_height="1dip"
        android:background="@android:color/white">
    </LinearLayout>
    <!-- 환자정보 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/pat_info_bar_height"
        android:background="@drawable/shape_navi_bg"
        >
        <TextView
            android:id="@+id/patientInfoTextView"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:layout_margin="10dip"
            android:textColor="@color/titleforeground"
            android:textSize="@dimen/normal_text_size"
            />
    </LinearLayout>
    <ExpandableListView
        android:groupIndicator="@null"
        android:id="@+id/certificate_list"  
        android:layout_width="fill_parent" 
        android:layout_height="fill_parent"
        android:layout_marginBottom="@dimen/bottom_area_height"
        android:cacheColorHint="@color/background"
        />
</LinearLayout>
