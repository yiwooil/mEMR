<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:paddingTop="8dip"
	android:paddingBottom="8dip"
	android:layout_width="fill_parent"
	android:layout_height="wrap_content"
	android:orientation="horizontal"
	>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
		<LinearLayout
		    android:layout_width="fill_parent"
		    android:layout_height="wrap_content"
            android:paddingBottom="8dip"
		    android:orientation="horizontal">
			<TextView
				android:id="@+id/labor_record_list_view_row_exdt"
				android:textColor="@color/foreground"
				android:textSize="@dimen/normal_text_size"
				android:layout_width="120dip"
				android:layout_height="wrap_content" />
		    <TextView
		        android:id="@+id/labor_record_list_view_row_extm"
		        android:textColor="@color/foreground"
                android:textSize="@dimen/normal_text_size"
		        android:layout_width="60dip"
		        android:layout_height="wrap_content" />
		    <TextView
		        android:id="@+id/labor_record_list_view_row_bp"
		        android:textColor="@color/foreground"
                android:textSize="@dimen/normal_text_size"
				android:layout_width="80dip"
		        android:layout_height="wrap_content" />
		    <TextView
		        android:id="@+id/labor_record_list_view_row_p"
		        android:textColor="@color/foreground"
                android:textSize="@dimen/normal_text_size"
				android:layout_width="40dip"
		        android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/labor_record_list_view_row_fht"
                android:textColor="@color/foreground"
                android:textSize="@dimen/normal_text_size"
				android:layout_width="60dip"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/labor_record_list_view_row_bt"
                android:textColor="@color/foreground"
                android:textSize="@dimen/normal_text_size"
				android:layout_width="60dip"
                android:layout_height="wrap_content" />
			<TextView
				android:id="@+id/labor_record_list_view_row_position"
				android:textColor="@color/foreground"
				android:textSize="@dimen/normal_text_size"
				android:layout_width="100dip"
				android:layout_height="wrap_content" />
			<TextView
				android:id="@+id/labor_record_list_view_row_station"
				android:textColor="@color/foreground"
				android:textSize="@dimen/normal_text_size"
				android:layout_width="80dip"
				android:layout_height="wrap_content" />
			<TextView
				android:id="@+id/labor_record_list_view_row_dilatation"
				android:textColor="@color/foreground"
				android:textSize="@dimen/normal_text_size"
				android:layout_width="100dip"
				android:layout_height="wrap_content" />
			<TextView
				android:id="@+id/labor_record_list_view_row_interval"
				android:textColor="@color/foreground"
				android:textSize="@dimen/normal_text_size"
				android:layout_width="100dip"
				android:layout_height="wrap_content" />
			<TextView
				android:id="@+id/labor_record_list_view_row_duration"
				android:textColor="@color/foreground"
				android:textSize="@dimen/normal_text_size"
				android:layout_width="100dip"
				android:layout_height="wrap_content" />
			<TextView
				android:id="@+id/labor_record_list_view_row_membrane"
				android:textColor="@color/foreground"
				android:textSize="@dimen/normal_text_size"
				android:layout_width="120dip"
				android:layout_height="wrap_content" />
			<TextView
				android:id="@+id/labor_record_list_view_row_med_rmk"
				android:textColor="@color/foreground"
				android:textSize="@dimen/normal_text_size"
				android:layout_width="200dip"
				android:layout_height="wrap_content" />
			<TextView
				android:id="@+id/labor_record_list_view_row_med_rmk2"
				android:textColor="@color/foreground"
				android:textSize="@dimen/normal_text_size"
				android:layout_width="100dip"
				android:layout_height="wrap_content" />
			<TextView
				android:id="@+id/labor_record_list_view_row_empnm"
				android:textColor="@color/foreground"
				android:textSize="@dimen/normal_text_size"
				android:layout_width="100dip"
				android:layout_height="wrap_content" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>