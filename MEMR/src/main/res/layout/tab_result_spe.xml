<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    >
    <LinearLayout
        android:id="@+id/result_spe_list_order_layout"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@color/tab_unselected_color"
        android:paddingTop="2dip"
        android:paddingRight="4dip"
        android:paddingBottom="4dip"
        android:paddingLeft="4dip"
        android:layout_marginBottom="@dimen/bottom_area_height"
        >
        <TextView
            android:id="@+id/result_spe_list_order_no_data"
            android:layout_width="fill_parent"
            android:layout_height="60dp"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:background="@drawable/bg_rounded_white"
            android:textColor="@android:color/black"
            android:text="등록된 자료가 없습니다."
            android:gravity="center"
            />
        <ExpandableListView
            android:id="@+id/result_spe_list_order"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:cacheColorHint="@color/background"
            android:divider="@null"
            android:dividerHeight="0dip"
            />
    </LinearLayout>
</LinearLayout>