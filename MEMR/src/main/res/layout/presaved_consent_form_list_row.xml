<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="8dip"
    android:paddingBottom="8dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/shape_listview_row"
    >
    <!-- 남녀를 구분하는 이미지 -->
    <ImageView
        android:id="@+id/pscf_image"
        android:paddingTop="6dip"
        android:layout_width="@dimen/patient_list_row_image_width"
        android:layout_height="@dimen/patient_list_row_image_width" />
    <!-- 일자나 동의서가 변경되는 경우 표시하는 부분 -->
    <TextView
        android:id="@+id/pscf_div_bar"
        android:textColor="@color/foreground"
        android:textSize="@dimen/normal_text_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <!-- 환자명 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/pscf_pnm"
            android:textColor="@color/foreground"
            android:textSize="@dimen/large_text_size"
            android:layout_width="@dimen/patient_list_row_pnm_width"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/pscf_pid"
            android:textColor="@color/foreground"
            android:textSize="@dimen/small_small_text_size"
            android:layout_width="@dimen/patient_list_row_pnm_width"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dip"
            android:orientation="horizontal">
            <!-- 성/나이 -->
            <TextView
                android:id="@+id/pscf_psexage"
                android:textColor="@color/foreground"
                android:textSize="@dimen/normal_text_size"
                android:layout_width="@dimen/patient_list_row_psexage_width"
                android:layout_height="wrap_content" />
            <!-- 진료과 -->
            <TextView
                android:id="@+id/pscf_dptcd"
                android:textColor="@color/foreground"
                android:textSize="@dimen/normal_text_size"
                android:layout_width="@dimen/patient_list_row_dptcd_width"
                android:layout_height="wrap_content" />
            <!-- 병동-병실-병상 -->
            <TextView
                android:id="@+id/pscf_ward"
                android:textColor="@color/foreground"
                android:textSize="@dimen/normal_text_size"
                android:layout_width="@dimen/patient_list_row_ward_width"
                android:layout_height="wrap_content" />
            <!-- 주치의 -->
            <TextView
                android:id="@+id/pscf_pdrnm"
                android:textColor="@color/foreground"
                android:textSize="@dimen/normal_text_size"
                android:layout_width="@dimen/patient_list_row_pdrnm_width"
                android:layout_height="wrap_content" />
            <!-- 진료자격 -->
            <TextView
                android:id="@+id/pscf_qfycdnm"
                android:textColor="@color/foreground"
                android:textSize="@dimen/normal_text_size"
                android:layout_width="@dimen/patient_list_row_qfycdnm_width"
                android:layout_height="wrap_content" />
            <!-- 입원일 ~ 퇴원일 -->
            <TextView
                android:id="@+id/pscf_disp_bededt_bedodt"
                android:textColor="@color/foreground"
                android:textSize="@dimen/normal_text_size"
                android:layout_width="@dimen/patient_list_row_disp_bededt_bedodt_width"
                android:layout_height="wrap_content" />
        </LinearLayout>   
        <!-- 진단명 -->
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
	        <TextView
	            android:id="@+id/pscf_ccf_name"
	            android:textColor="@color/foreground"
	            android:textSize="@dimen/normal_text_size"
	            android:layout_width="wrap_content"
	            android:layout_height="wrap_content"
                android:paddingBottom="8dip"/>
	        <TextView
                android:id="@+id/pscf_exdt_seq"
                android:textColor="@color/foreground"
                android:textSize="@dimen/small_small_text_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dip"/>
	    </LinearLayout>
    </LinearLayout>                 
</LinearLayout>