<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/background"
    >
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        >
        <!-- temr로고는 일부러 뺐음. -->
        <!-- 흰색 줄이 있는 효과를 내기 위함. -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="1dip"
            android:background="@android:color/white"
            >
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="fill_parent"
            android:layout_height="45dip"
            android:background="@drawable/shape_navi_bg"
            >
            <TextView
                android:id="@+id/patientInfoTextView"
                android:layout_width="wrap_content"
                android:layout_height="fill_parent"
                android:layout_margin="10dip"
                android:textColor="@color/titleforeground"
                android:textSize="@dimen/normal_text_size"
                />
            <HorizontalScrollView
	            android:layout_width="wrap_content"
	            android:layout_height="fill_parent"
	            android:layout_marginLeft="10dip"
	        >
	        <RadioGroup 
	            android:id="@+id/page_group"
	            android:layout_width="wrap_content"
	            android:layout_height="wrap_content"
	            android:layout_gravity="center_vertical"
	            android:orientation="horizontal"
	            >
	            <RadioButton
	                android:id="@+id/page_1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
	                android:text="1 "
	                android:checked="true" />
	            <RadioButton
	                android:id="@+id/page_2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
	                android:text="2 " />
	            <RadioButton
	                android:id="@+id/page_3"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
	                android:text="3 " />
	            <RadioButton
	                android:id="@+id/page_4"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
	                android:text="4 " />
	            <RadioButton
	                android:id="@+id/page_5"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
	                android:text="5 " />
	            <RadioButton
	                android:id="@+id/page_6"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
	                android:text="6 " />
	            <RadioButton
	                android:id="@+id/page_7"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
	                android:text="7 " />
	            <RadioButton
	                android:id="@+id/page_8"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
	                android:text="8 " />
	            <RadioButton
	                android:id="@+id/page_9"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
	                android:text="9 " />
				<RadioButton
					android:id="@+id/page_10"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
					android:text="10 " />
				<RadioButton
					android:id="@+id/page_11"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
					android:text="11 " />
				<RadioButton
					android:id="@+id/page_12"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
					android:text="12 " />
				<RadioButton
					android:id="@+id/page_13"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
					android:text="13 " />
				<RadioButton
					android:id="@+id/page_14"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
					android:text="14 " />
				<RadioButton
					android:id="@+id/page_15"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:minWidth="42dp"
					android:minHeight="42dp"
					android:button="@null"
					android:background="@drawable/radio_underline_selector"
					android:gravity="center"
					android:padding="0dp"
					android:text="15 " />
	        </RadioGroup>
	        </HorizontalScrollView>
            
        </LinearLayout>
        <WebView 
            android:id="@+id/webView"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
             />
   </LinearLayout>
   <!-- 안보이게 처리해 놓았음. -->
   <LinearLayout
       android:orientation="horizontal"
       android:layout_width="fill_parent"
       android:layout_height="fill_parent"
       android:gravity="right|bottom"
       android:visibility="gone"
       >
       <Button
           android:id="@+id/rotateRightButton"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="@string/rotate_right" />
       <Button
           android:id="@+id/rotateLeftButton"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="@string/rotate_left" />
   </LinearLayout>
</FrameLayout>



