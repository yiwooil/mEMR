<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    >
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        >
        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="@color/tab_unselected_color"
            android:paddingTop="2dip"
            android:paddingRight="4dip"
            android:paddingBottom="4dip"
            android:paddingLeft="4dip"
            >
            <include layout="@layout/result_lis_column_header"></include>
        </LinearLayout>
        <!-- 구분선 -->
        <LinearLayout 
            android:layout_width="fill_parent"
            android:layout_height="1dip"
            android:background="@android:color/black">
        </LinearLayout>
        <!-- 자료조회 -->
	    <LinearLayout
	        android:layout_width="fill_parent"
	        android:layout_height="fill_parent"
	        android:background="@color/tab_unselected_color"
	        android:paddingTop="2dip"
	        android:paddingRight="4dip"
	        android:paddingBottom="4dip"
	        android:paddingLeft="4dip"
			android:orientation="vertical"
	        >
			<TextView
				android:id="@+id/result_lis_list_no_data"
				android:layout_width="fill_parent"
				android:layout_height="60dp"
				android:textAppearance="?android:attr/textAppearanceLarge"
				android:background="@drawable/bg_rounded_white"
				android:textColor="@android:color/black"
				android:text="등록된 자료가 없습니다."
				android:gravity="center"
				/>
   	        <ListView
	            android:id="@+id/result_lis_list"  
	            android:layout_width="fill_parent" 
	            android:layout_height="fill_parent"
	            android:cacheColorHint="@color/background"
	            android:divider="@null"
	            android:dividerHeight="0dip"
	            />
	    </LinearLayout>
    </LinearLayout>
</LinearLayout>